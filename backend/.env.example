# backend/.env.example — คัดลอกเป็น backend/.env แล้วใส่ค่าจริง (ห้าม commit .env)
SUPABASE_URL=
# service role key: ข้าม RLS — ใช้ฝั่ง server เท่านั้น
SUPABASE_SERVICE_ROLE_KEY=
PORT=5000
# ยังไม่ถูกใช้ในโค้ด (ดู DEVELOPMENT_STATUS Known Issue #14)
FRONTEND_URL=http://localhost:5173
# OpenRouteService (ไม่ใส่ = ใช้ haversine แทน)
ORS_API_KEY=
# Google Places (Find Place + Details) + Places API (New) priceRange (D-52 — ต้องเปิด Places API (New) ให้ key นี้) — ใช้โดย admin pipeline ตอนนำเข้า (R5 P4) · server เท่านั้น ห้ามใส่ใน VITE_*
GOOGLE_PLACES_API_KEY=
# ตัวเลือก (มีค่า default ใน src/config/ors.ts)
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ORS_PROFILE=driving-car
# ORS_TIMEOUT_MS=8000
# ORS_MATRIX_CHUNK_SIZE=500
# ORS_CACHE_TTL_MS=86400000
