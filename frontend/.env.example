# frontend/.env.example — ทุกค่า VITE_* จะถูกฝังใน bundle ของ browser: ห้ามใส่ secret ฝั่ง server
# ว่าง = ใช้ path /api ผ่าน Vite proxy
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# ถูกเปิดเผยใน browser (ดู Known Issue #8)
VITE_ORS_API_KEY=
# VITE_ORS_BASE_URL=https://api.heigit.org/openrouteservice
# VITE_ORS_PROFILE=driving-car
